{
  "name": "smart-serve",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "prisma generate && next dev --turbopack",
    "build": "prisma generate && next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "prisma:generate": "prisma generate",
    "prisma:seed": "node prisma/seed.mjs",
    "postinstall": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "test": "rm -rf .test-dist && tsc -p tsconfig.test.json && node --test .test-dist/src/**/*.test.js && rm -rf .test-dist",
    "test:unit": "npm run test",
    "test:e2e": "echo \"Playwright is not installed in this environment\" && exit 1"
  },
  "dependencies": {
    "next": "15.5.15",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zustand": "^5.0.8",
    "@prisma/client": "^6.7.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.15",
    "tailwindcss": "^4",
    "typescript": "^5",
    "prisma": "^6.7.0"
  }
}
