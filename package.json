{
  "name": "smart-serve",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "prisma generate && next dev --turbopack",
    "dev:webpack": "prisma generate && next dev",
    "build": "prisma generate && next build --turbopack",
    "build:demo": "prisma generate && if [ \"$VERCEL_ENV\" = \"production\" ]; then prisma migrate deploy && PUBLIC_DEMO_SEED=true RUN_PRISMA_SEED=true tsx prisma/seed.ts; fi && next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:seed": "prisma db seed",
    "bootstrap:demo": "node --env-file=.env --import tsx prisma/bootstrap-demo.ts",
    "setup:demo": "node --env-file=.env ./node_modules/prisma/build/index.js migrate deploy && node --env-file=.env --import tsx prisma/bootstrap-demo.ts",
    "postinstall": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "test": "rm -rf .test-dist && tsc -p tsconfig.test.json && node --test .test-dist/src/**/*.test.js && rm -rf .test-dist",
    "test:unit": "npm run test",
    "test:e2e": "echo \"E2E suite is not configured; see README roadmap\""
  },
  "dependencies": {
    "@prisma/client": "6.12.0",
    "next": "^15.5.24",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15.5.24",
    "prisma": "6.12.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "postcss": "^8.5.26",
    "sharp": "^0.35.4"
  },
  "prisma": {
    "seed": "RUN_PRISMA_SEED=true tsx prisma/seed.ts"
  }
}
