# PostgreSQL: pooled runtime URL and direct migration URL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_TIME_ZONE=Europe/Madrid

# Polling is always active. Enable only if Supabase owns the same PostgreSQL tables.
NEXT_PUBLIC_ENABLE_SUPABASE_REALTIME=false
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_KITCHEN_REFRESH_INTERVAL_MS=5000

# Development/demo seed only; production seed hard-fails.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-local-demo-password
SEED_ADMIN_NAME=Demo Admin

# One-time production demo bootstrap. Do not add these to Vercel.
# Run npm run bootstrap:demo locally against the target Neon database instead.
# BOOTSTRAP_DEMO_CONFIRM=CREATE_DEMO_DATA
# BOOTSTRAP_OWNER_EMAIL=demo-owner@example.com
# BOOTSTRAP_OWNER_PASSWORD=use-a-unique-password-of-at-least-12-characters
# BOOTSTRAP_OWNER_NAME=Demo Owner
