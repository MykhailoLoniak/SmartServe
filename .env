# PostgreSQL connection for local development
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/smartserve?schema=public"
DATABASE_URL=postgres://postgres:mysecretpassword@localhost:5432/postgres?schema=public
SMARTSERVE_ADMIN_USERNAME=admin@example.com
SMARTSERVE_ADMIN_PASSWORD=admin123
SMARTSERVE_STAFF_USERNAME=staff
SMARTSERVE_STAFF_PASSWORD=staff123