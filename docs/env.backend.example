# Local PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smartserve?schema=public

# Neon PostgreSQL
# Use the pooled "-pooler" hostname for the app runtime.
# DATABASE_URL=postgresql://USER:PASSWORD@ENDPOINT-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&connection_limit=1&pool_timeout=20&connect_timeout=15
#
# Use the direct hostname for Prisma CLI commands and migrations.
# DIRECT_URL=postgresql://USER:PASSWORD@ENDPOINT.REGION.aws.neon.tech/DBNAME?sslmode=require&connect_timeout=15

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Auth/session
SESSION_SECRET=change-me
SENTRY_DSN=

# Legacy basic auth vars removed in production mode
